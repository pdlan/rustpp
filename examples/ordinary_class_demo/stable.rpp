class Child {
    address: usize,

    constructor(seed: i32) {
        new { address: 0 }

        init {
            assert_eq!(seed, 42);
            self.address = self as *const _ as usize;
        }
    }

    destructor {
        deinit {
            assert_eq!(self.address, self as *const _ as usize);
        }
    }
}

class Parent {
    child: Child,

    constructor() {
        new { child: construct Child(42) }
        init {}
    }

    destructor {
        deinit {}
    }
}

class A {
    constructor() {
        new {}
        init {
            assert_eq!(self.dispatch_probe(), 1);
            assert!(__rpp_is_exact_a(&*self));
            assert_ne!(self.__rpp_type_desc().active_class_id(), self.__rpp_type_desc().complete_storage_class_id());
            assert!(__rpp_cast_ref_a_to_derived(&*self).is_none());
        }
    }

    pub virtual fn stage_kind(&self) -> i32 { 1 }
    pub fn dispatch_probe(&self) -> i32 { self.stage_kind() }

    destructor {
        deinit {
            assert_eq!(self.dispatch_probe(), 1);
            assert!(__rpp_is_exact_a(&*self));
            assert!(__rpp_cast_ref_a_to_derived(&*self).is_none());
        }
    }
}

class B {
    constructor() { new {} }
}

class Derived : public A, public B {
    constructor() {
        new { base A(), base B() }
        init {
            assert_eq!(self.dispatch_probe(), 2);
            assert!(__rpp_is_exact_derived(&*self));
            assert_eq!(self.__rpp_type_desc().active_class_id(), self.__rpp_type_desc().complete_storage_class_id());
        }
    }

    pub override fn stage_kind(&self) -> i32 { 2 }

    destructor {
        deinit {
            assert_eq!(self.dispatch_probe(), 2);
            assert!(__rpp_is_exact_derived(&*self));
        }
    }
}

pub fn direct_parent() {
    let _parent: Parent = construct Parent();
}
