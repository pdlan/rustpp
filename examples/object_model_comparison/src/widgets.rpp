class Widget {
    pub id: usize,

    constructor(id: usize) { new { id } }

    pub virtual fn paint(&self) -> String {
        let id = self.id;
        format!("widget #{id}")
    }

}

class Clickable {
    pub clicks: usize,

    constructor() { new { clicks: 0 } }

    pub virtual fn click(&mut self) {
        self.clicks += 1;
    }

    pub fn click_count(&self) -> usize {
        self.clicks
    }

}

class Accessible {
    pub label: String,

    constructor(label: String) { new { label } }

    pub virtual fn describe(&self) -> String {
        self.label.clone()
    }

}

class ToggleButton : public Widget, public Clickable, public Accessible {
    checked: bool,

    constructor(id: usize, label: String) {
        new {
            base Widget(id),
            base Clickable(),
            base Accessible(label),
            checked: false,
        }
    }

    pub override fn paint(&self) -> String {
        let id = self.id;
        let description = self.describe();
        format!("[ #{id} {description} ]")
    }

    pub override fn click(&mut self) {
        self.clicks += 1;
        self.checked = !self.checked;
    }

    pub override fn describe(&self) -> String {
        let label = self.label.clone();
        let state = if self.checked { "checked" } else { "unchecked" };
        format!("{label}: {state}")
    }

    pub fn is_checked(&self) -> bool {
        self.checked
    }

}

fn main() {
    let concrete: Box<ToggleButton> =
        construct Box<ToggleButton>(7, "Dark mode".to_owned());
    let original_address = concrete.__rpp_complete_address();

    // Infallible owner upcast. The complete ToggleButton allocation is stable.
    let mut widget: Box<Widget> = concrete;
    assert_eq!(widget.__rpp_complete_address(), original_address);
    assert!(widget is ToggleButton);
    assert_eq!(widget.paint(), "[ #7 Dark mode: unchecked ]");

    // Dynamic sibling cross-cast: Widget -> Clickable.
    {
        let clickable = (&mut *widget as? Clickable).unwrap();
        clickable.click();
        assert_eq!(clickable.click_count(), 1);
        assert_eq!(clickable.__rpp_complete_address(), original_address);
    }

    // Dynamic sibling cross-cast: Widget -> Accessible.
    let accessible = (&*widget as? Accessible).unwrap();
    assert_eq!(accessible.describe(), "Dark mode: checked");
    assert_eq!(accessible.__rpp_complete_address(), original_address);

    // Owning downcast: Widget -> ToggleButton, without reallocating.
    let toggle: Box<ToggleButton> = (widget as? ToggleButton)
        .unwrap_or_else(|_| panic!("expected ToggleButton"));
    assert!(toggle.is_checked());
    assert_eq!(toggle.__rpp_complete_address(), original_address);

    println!("{}", toggle.paint());
    println!("clicks={}, same_address=true", toggle.click_count());
}
